# Supabase (existing - already configured)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# AI Services (NEW - add these)
# Get Gemini key: https://aistudio.google.com/app/apikey (FREE)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Get Groq key: https://console.groq.com/keys (FREE - fallback)
VITE_GROQ_API_KEY=your_groq_api_key_here

# ── Production / metered mode (Phase 0) ────────────────────────────────────────
# When set, generation routes through the /convert edge function (keys hidden,
# usage metered, free/pro tiered routing). Leave unset for local dev
# (uses VITE_GEMINI_API_KEY / VITE_GROQ_API_KEY directly).
# Example: https://<project>.functions.supabase.co/convert
VITE_CONVERT_PROXY_URL=
